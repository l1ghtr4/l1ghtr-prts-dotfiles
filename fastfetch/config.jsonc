{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "~/.config/fastfetch/logos/*",
        "width": 30,
        "padding": {
            "right": 2,
        },
    },
    "display": {
        "separator": " ",
    },
    "modules": [
        {
            "type": "custom",
            "key": "                      PRTS",
            "keyColor": "#d5c4a1",
        },
        "break",
        {
            "type": "title",
            "key": "prts_usr",
            "format": "{user-name}",
            "keyColor": "#d5c4a1",
        },
        {
            "type": "host",
            "key": "prts_host",
            "keyColor": "#d5c4a1",
        },
        "break",
        {
            "type": "custom",
            "key": "# # # # # # # # # # # # # # # # # # # # # # # #",
            "keyColor": "#d79921",
        },
        "break",
        {
            "type": "os",
            "key": "os",
            "keyColor": "#fe8019",
        },
        {
            "type": "packages",
            "key": "pkg",
            "keyColor": "#fe8019",
        },
        {
            "type": "shell",
            "key": "sh",
            "keyColor": "#fe8019",
        },
        {
            "type": "terminal",
            "key": "ter",
            "keyColor": "#fe8019",
        },
        "break",
        {
            "type": "custom",
            "key": "# # # # # # # # # # # # # # # # # # # # # # # #",
            "keyColor": "#d79921",
        },
        "break",
        {
            "type": "cpu",
            "key": "cpu",
            "keyColor": "#cc241d",
        },
        {
            "type": "memory",
            "key": "mem",
            "keyColor": "#cc241d",
        },
        {
            "type": "uptime",
            "key": "ti",
            "keyColor": "#cc241d",
        },
        "break",
    ],
}
